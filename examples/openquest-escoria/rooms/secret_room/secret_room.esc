:setup
	if ensign_zob_room == "SecretRoom":
		set_active("player", true)
	else:
		set_active("player", false)
	if bluecup_actor_room == "SecretRoom":
		set_active("bluecup_actor", true)
	else:
		set_active("bluecup_actor", false)
	if cube_actor_room == "SecretRoom":
		set_active("cube_actor", true)
	else:
		set_active("cube_actor", false)
	if commander_zif_room == "SecretRoom":
		set_active("commander_zif", true)
	else:
		set_active("commander_zif", false)
	scumm_restore_names()
	scumm_roam("", "setup")
	scumm_fade_in()

:ready
	ensign_zob_room = "SecretRoom"
	set_active("player", true)
	teleport_pos("player", 160, 400)
	walk_to_pos("player", 368, 400)
