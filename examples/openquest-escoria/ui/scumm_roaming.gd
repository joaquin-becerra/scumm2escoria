class_name ScummRoaming
extends Node
# Generated by scumm2escoria from the game's roaming script (Actors::roam):
# while an actor roams, every DELAY_MIN..DELAY_MAX seconds it may (CHANCE)
# walk to a random point of its rectangle. The state of each actor lives in a
# global (scumm_roam_<actor>: "state,x_min,x_max,y_min,y_max") so it survives
# room changes and saved games. Like the original it keeps going while the
# actor is in another room, but only walks it when it is in the current one,
# and (unlike SCUMM) only when no game event is running, so it never fights a
# script that moves the actor.

const PREFIX := "scumm_roam_"
const DELAY_MIN := 0.833
const DELAY_MAX := 3.333
const CHANCE := 0.5

var _timers := {}


static func get_node_instance() -> ScummRoaming:
	var node = escoria.get_node_or_null("ScummRoaming")
	if node == null:
		node = ScummRoaming.new()
		node.name = "ScummRoaming"
		escoria.add_child(node)
	return node


func control(actor: String, op: String, rect: Array) -> void:
	if op == "setup":
		return
	var state := _state(actor)
	match op:
		"start":
			state = ["running"] + rect
		"pause", "resume", "stop":
			if state.is_empty() or state[0] == "stopped":
				return      # like the original: nothing to pause / resume / stop
			state[0] = {"pause": "paused", "resume": "running", "stop": "stopped"}[op]
	escoria.globals_manager.set_global(PREFIX + actor, ",".join(state.map(func(v): return str(v))), true)
	if op in ["pause", "stop"]:
		var node = _node(actor)
		if node and node.is_moving():
			node.stop_walking_now()       # setActorStanding


func _process(delta: float) -> void:
	var globals: Dictionary = escoria.globals_manager.get_globals()
	for key in globals:
		if not str(key).begins_with(PREFIX):
			continue
		var actor := str(key).substr(PREFIX.length())
		var state := _state(actor)
		if state.size() < 5 or state[0] != "running":
			continue
		_timers[actor] = _timers.get(actor, 0.0) - delta
		if _timers[actor] > 0.0:
			continue
		_timers[actor] = randf_range(DELAY_MIN, DELAY_MAX)
		if randf() >= CHANCE:
			continue
		var node = _node(actor)
		if node == null or not node.is_visible_in_tree() or node.is_moving() \
				or not escoria.event_manager.is_channel_free(escoria.event_manager.CHANNEL_FRONT):
			continue
		var target := Vector2(randi_range(int(state[1]), int(state[2])), randi_range(int(state[3]), int(state[4])))
		node.walk_to(target, ESCWalkContext.new(null, target, false, true))


func _state(actor: String) -> Array:
	if not escoria.globals_manager.has(PREFIX + actor):
		return []
	return Array(str(escoria.globals_manager.get_global(PREFIX + actor)).split(","))


func _node(actor: String):
	if not escoria.object_manager.has(actor):
		return null
	var obj = escoria.object_manager.get_object(actor)
	return obj.node if obj and is_instance_valid(obj.node) else null
