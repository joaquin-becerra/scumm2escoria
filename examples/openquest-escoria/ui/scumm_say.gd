extends "res://addons/escoria-dialog-simple/types/floating.gd"
# Generated by scumm2escoria: speech the way SCUMM v6 shows it.
# - the whole line at once (no typing effect),
# - centered on the actor's talk position, kept at least 80 pixels of the original
#   screen from its sides, and wrapped so it stays on screen
#   (line width at most 2 * min(x, screen width - x)),
# - shown for (characters * VAR_CHARINC) game frames.

const SCREEN_WIDTH := 1280
const SIDE_MARGIN := 320
const CHAR_INC := 4
const GAME_FPS := 30.0


func _ready():
	super()
	fit_content = true
	autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	scroll_active = false
	mouse_filter = Control.MOUSE_FILTER_IGNORE


func say(character: String, line: String):
	super(character, line)
	_scumm_layout()


func _scumm_layout() -> void:
	if not is_instance_valid(dialog_location_node):
		return
	var x := _center_x()
	var max_width: float = 2.0 * minf(x, SCREEN_WIDTH - x)
	var font := get_theme_font("normal_font")
	var font_size := get_theme_font_size("normal_font_size")
	var width := font.get_string_size(get_parsed_text(), HORIZONTAL_ALIGNMENT_LEFT, -1, font_size).x
	size = Vector2(minf(width + 2, max_width), 0)
	position.x = x - size.x / 2
	position.y = maxf(position.y, 0.0)


func _center_x() -> float:
	var origin: Vector2 = dialog_location_node.get_global_transform_with_canvas().origin
	return clampf(origin.x, SIDE_MARGIN, SCREEN_WIDTH - SIDE_MARGIN)


# Escoria places the text again on every frame, from the actor's real position.
func _process(delta):
	super(delta)
	if is_instance_valid(dialog_location_node):
		position.x = _center_x() - size.x / 2


func _calculate_time_to_disappear() -> float:
	return len(_current_line) * CHAR_INC / GAME_FPS
