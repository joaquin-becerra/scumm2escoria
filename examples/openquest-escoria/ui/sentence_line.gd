extends ESCTooltip
# Generated by scumm2escoria from the game's verb labels.

const LABELS = {"give": "Give", "pickup": "Pick up", "use": "Use", "open": "Open", "look": "Examine", "smell": "Smell", "talk": "Talk to", "move": "Move", "walk": "Walk to"}
const PREPOSITIONS = {"use": "with", "give": "to"}


func _ready():
	super()
	# SCUMM's sentence line always shows something ("Walk to" at rest).
	update_tooltip_text()


func _preposition() -> String:
	# Each item's own word (its SCUMM Preposition case), else the verb's usual one.
	var tool = escoria.action_manager.current_tool
	if tool and tool.node and tool.node.custom_data.has("preposition_" + current_action):
		return tool.node.custom_data["preposition_" + current_action]
	return PREPOSITIONS.get(current_action, current_prep.strip_edges())


func update_tooltip_text():
	var verb: String = LABELS.get(current_action, LABELS["walk"])
	var line := verb
	if not current_target.is_empty():
		line += " " + current_target
	# Escoria leaves the second object behind when a "use X with Y" never
	# finishes (interrupted walk, unreachable target): only keep it while a
	# second object is actually being chosen or used.
	var state = escoria.action_manager.action_state
	if state != ESCActionManager.ActionInputState.AWAITING_TARGET_ITEM \
			and state != ESCActionManager.ActionInputState.COMPLETED:
		waiting_for_target2 = false
		current_target2 = ""
	if waiting_for_target2 or not current_target2.is_empty():
		line += " " + _preposition()
	if not current_target2.is_empty():
		line += " " + current_target2
	text = "[center][color=#" + color.to_html(false) + "]" + line + "[/color][/center]"
