extends "res://addons/escoria-dialog-simple/chooser/simple.gd"
# Generated by scumm2escoria: dialog choices laid out like the game's dialog
# library (showDialog): at most MAX_LINES lines at (LINE_X, LINE_Y + LINE_STEP * n),
# in the dialog charset, scrolled MAX_LINES / 2 at a time with arrows.

const LINE_X := 48
const LINE_Y := 580
const LINE_STEP := 44
const MAX_LINES := 5
const FONT := "res://fonts/dialog_charset.fnt"
const FONT_SIZE := 40
const ARROW_FONT := "res://fonts/verb_chset.fnt"
const ARROW_FONT_SIZE := 40
const ARROWS := [[8, 580, "\u0003"], [8, 756, "\u0002"]]
const COLOR_NORMAL := Color(0.5059, 0.2196, 0.3098, 1)
const COLOR_HOVER := Color(0.6549, 0.1216, 0.2235, 1)

var _lines: Control
var _options: Array = []
var _offset := 0


func _ready() -> void:
	super()
	_lines = Control.new()
	_lines.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(_lines)
	_lines.hide()


func show_chooser():
	_options = []
	for option in self.dialog.options:
		if option.is_valid():
			_options.append(option)
	if _options.is_empty():
		_no_more_options = true
		$Timer.start(0.05)
		return
	_offset = 0
	_build()
	_lines.show()


func hide_chooser():
	super()
	if _lines:
		_lines.hide()


func _button(text: String, pos: Vector2, font_path: String, font_size: int) -> Button:
	var b := Button.new()
	b.text = text
	b.flat = true
	b.focus_mode = Control.FOCUS_NONE
	b.alignment = HORIZONTAL_ALIGNMENT_LEFT
	b.position = pos
	for style in ["normal", "hover", "pressed", "hover_pressed", "focus"]:
		b.add_theme_stylebox_override(style, StyleBoxEmpty.new())
	if font_path != "":
		b.add_theme_font_override("font", load(font_path))
		b.add_theme_font_size_override("font_size", font_size)
	b.add_theme_color_override("font_color", COLOR_NORMAL)
	for c in ["font_hover_color", "font_pressed_color", "font_hover_pressed_color"]:
		b.add_theme_color_override(c, COLOR_HOVER)
	_lines.add_child(b)
	return b


func _build() -> void:
	for c in _lines.get_children():
		c.queue_free()
	var shown := _options.slice(_offset, _offset + MAX_LINES)
	for i in shown.size():
		var b := _button(shown[i].option, Vector2(LINE_X, LINE_Y + LINE_STEP * i), FONT, FONT_SIZE)
		b.pressed.connect(_on_answer_selected.bind(shown[i]))
	if ARROWS.size() == 2:
		if _offset > 0:
			_button(ARROWS[0][2], Vector2(ARROWS[0][0], ARROWS[0][1]), ARROW_FONT, ARROW_FONT_SIZE) \
				.pressed.connect(_scroll.bind(-1))
		if _offset + MAX_LINES < _options.size():
			_button(ARROWS[1][2], Vector2(ARROWS[1][0], ARROWS[1][1]), ARROW_FONT, ARROW_FONT_SIZE) \
				.pressed.connect(_scroll.bind(1))


func _scroll(direction: int) -> void:
	_offset = clampi(_offset + direction * (MAX_LINES / 2), 0, maxi(_options.size() - MAX_LINES, 0))
	_build()
