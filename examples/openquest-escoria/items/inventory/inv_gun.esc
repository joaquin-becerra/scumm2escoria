:give "commander_zif"
	if !has_shot_at_node:
		say("player", "And lose my advantage?")
		stop
	# SecretRoom::outro()
	var i = 0
	scumm_roam("commander_zif", "stop")
	accept_input("SKIP")
	set_gui_visible(false)
	say("player", "I'm having problems hitting the target, Sir.")
	say("commander_zif", "You're not a soldier. Give it here.")
	walk_block("commander_zif", "player")
	turn_to("commander_zif", "player")
	turn_to("player", "commander_zif")
	if "inv_gun" in inventory:
		inventory_remove("inv_gun")
	scumm_anim("player", "raise_arm")
	wait(0.25)
	scumm_anim("commander_zif", "raise_arm")
	wait(0.25)
	scumm_anim("player", "lower_arm")
	wait(0.25)
	scumm_anim("commander_zif", "lower_arm")
	wait(0.25)
	say("commander_zif", "Right, stand back.")
	walk_to_pos_block("player", 840, 480)
	walk_block("commander_zif", "node")
	turn_to("player", "commander_zif")
	say("commander_zif", "I shall disable the suspension field thusly.")
	wait(1.67)
	scumm_sound("res://sounds/shoot_cage_snd.wav")
	scumm_anim("commander_zif", "fireup")
	wait(0.5)
	wait(0.03)
	scumm_elevation("bluecup_actor", 55)
	wait(0.03)
	scumm_elevation("bluecup_actor", 50)
	wait(0.03)
	scumm_elevation("bluecup_actor", 45)
	wait(0.03)
	scumm_elevation("bluecup_actor", 40)
	wait(0.03)
	scumm_elevation("bluecup_actor", 35)
	wait(0.03)
	scumm_elevation("bluecup_actor", 30)
	wait(0.03)
	scumm_elevation("bluecup_actor", 25)
	wait(0.03)
	scumm_elevation("bluecup_actor", 20)
	wait(0.03)
	scumm_elevation("bluecup_actor", 15)
	wait(0.03)
	scumm_elevation("bluecup_actor", 10)
	wait(0.03)
	scumm_elevation("bluecup_actor", 5)
	wait(1.67)
	walk_block("commander_zif", "bluecup_actor")
	set_angle("commander_zif", 180)
	wait(1.67)
	bluecup_actor_room = "InventoryItems"
	set_active("bluecup_actor", false)
	say("commander_zif", "At last, the power of the relic is mine.")
	say("player", "Expertly done, Sir.")
	say("player", "Pass over the relic, and I shall place it in the containment vessel.")
	walk_to_pos_block("commander_zif", 400, 460)
	turn_to("commander_zif", "player")
	say("commander_zif", "Never!")
	say("commander_zif", "The relic shall never leave my side.")
	say("player", "But commander, the power is too much for one man.")
	say("player", "Yield it, before it destroys you!")
	say("commander_zif", "Error, number one.")
	say("commander_zif", "Never give up the gun.")
	scumm_sound("res://sounds/shoot_dead_snd.wav")
	scumm_anim("commander_zif", "firestraight")
	wait(0.83)
	scumm_sound("res://sounds/fall_dead_snd.wav")
	scumm_anim("player", "die")
	wait(2.5)
	walk_to_pos_block("commander_zif", 680, 480)
	say("commander_zif", "What a shame...")
	say("commander_zif", "We could have ruled the cosmos together.")
	set_angle("commander_zif", 180)
	# Actors::setZifOnThePhone()
	set_animations("commander_zif", "res://characters/commander_zif/commander_zif_stand_with_phone_talk_to_phone_start.tres")
	scumm_anim("commander_zif", "look_around")
	wait(0.5)
	say("commander_zif", "Commander's log, star date 432.2")
	say("commander_zif", "I have obtained the stolen artifact.")
	say("commander_zif", "In a slight contradiction to my orders, I have decided to enslave this planet.")
	say("commander_zif", "Mwaaah huh huh huh huh huh huh...", "mwwwah_snd")
	# Actors::setZifOffThePhone()
	set_animations("commander_zif", "res://characters/commander_zif/commander_zif_animations.tres")
	# override block (not skipped: VAR_OVERRIDE = 0)
	accept_input("ALL")
	scumm_wait_click()
	# ResRoom::quit() on the next click
	scumm_quit()

:give "carol"
	say("player", "I might need this.")

:give_with
	say("player", "I might need this.")

:use "carol"
	say("player", "Terminating this lifeform could attract unwarranted attention.")
	if inv_gun_state < 2:
		say("player", "And the weapon is not loaded anyway.")

:use "commander_zif"
	say("player", "I can't use that on someone!")

:look
	say("player", "A crude ballistic firearm fashioned from a primitive alloy.")
