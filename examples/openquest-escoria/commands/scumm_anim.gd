class_name ScummAnimCommand
extends ESCBaseCommand
# Generated by scumm2escoria.
# `scumm_anim(object, animation)`: play a costume animation the way SCUMM's
# animateActor does, with the frames for where the actor faces right now
# (<animation>_up/right/down/left). Costumes that mirror the left side only
# have _right: the sprite is already flipped while the actor faces left.

const DIRECTIONS := ["up", "right", "down", "left"]   # order of the animation resource


func configure() -> ESCCommandArgumentDescriptor:
	return ESCCommandArgumentDescriptor.new(2, [TYPE_STRING, TYPE_STRING], [null, null])


func validate(arguments: Array):
	if not super.validate(arguments):
		return false
	if not escoria.object_manager.has(arguments[0]):
		raise_invalid_object_error(self, arguments[0])
		return false
	return true


func run(command_params: Array) -> int:
	var node: ESCItem = escoria.object_manager.get_object(command_params[0]).node
	var animator: ESCAnimationPlayer = node.get_animation_player()
	var dir := 2
	if node._movable:
		dir = clampi(node._movable.last_dir, 0, DIRECTIONS.size() - 1)
	var candidates := [DIRECTIONS[dir]]
	if DIRECTIONS[dir] == "left":
		candidates.append("right")
	candidates.append_array(["down", "right", "up", "left"])
	for d in candidates:
		var anim_name: String = "%s_%s" % [command_params[1], d]
		if animator.has_animation(anim_name):
			animator.play(anim_name)
			return ESCExecution.RC_OK
	escoria.logger.warn(self, "No animation %s for %s" % [command_params[1], command_params[0]])
	return ESCExecution.RC_OK


func interrupt():
	pass
