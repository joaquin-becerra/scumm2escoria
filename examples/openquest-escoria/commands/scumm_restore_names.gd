class_name ScummRestoreNamesCommand
extends ESCBaseCommand
# Generated by scumm2escoria. `scumm_restore_names()`: in a room's :setup,
# give its objects the names scumm_set_name() changed.


func configure() -> ESCCommandArgumentDescriptor:
	return ESCCommandArgumentDescriptor.new(0, [], [])


func run(_command_params: Array) -> int:
	var globals: Dictionary = escoria.globals_manager.get_globals()
	for key in globals:
		if str(key).begins_with(ScummSetNameCommand.PREFIX):
			ScummSetNameCommand.apply(str(key).substr(ScummSetNameCommand.PREFIX.length()), str(globals[key]))
	return ESCExecution.RC_OK


func interrupt():
	pass
