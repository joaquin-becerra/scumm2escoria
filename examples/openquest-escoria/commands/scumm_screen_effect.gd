class_name ScummScreenEffectCommand
extends ESCBaseCommand
# Generated by scumm2escoria. `scumm_screen_effect(code)`: SCUMM's screenEffect(0xAABB), the effects
# for the next room changes (AA leaving, BB entering).


func configure() -> ESCCommandArgumentDescriptor:
	return ESCCommandArgumentDescriptor.new(1, [TYPE_INT], [null])


func run(command_params: Array) -> int:
	escoria.globals_manager.set_global(ScummScreen.GLOBAL, command_params[0], true)
	return ESCExecution.RC_OK


func interrupt():
	pass
