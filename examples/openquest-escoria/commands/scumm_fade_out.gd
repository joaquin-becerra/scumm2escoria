class_name ScummFadeOutCommand
extends ESCBaseCommand
# Generated by scumm2escoria. `scumm_fade_out([from_black])`: leaving a room, before change_scene.
# from_black: the game starts from an empty screen.


func configure() -> ESCCommandArgumentDescriptor:
	return ESCCommandArgumentDescriptor.new(0, [TYPE_BOOL], [false])


func run(command_params: Array) -> int:
	await ScummScreen.get_screen().fade_out(command_params[0])
	return ESCExecution.RC_OK


func interrupt():
	pass
