class_name ScummWaitClickCommand
extends ESCBaseCommand
# Generated by scumm2escoria.
# `scumm_wait_click()`: block until the player clicks. SCUMM scripts hand the
# next click to another script (VAR_VERB_SCRIPT = x), e.g. "click to quit".


class _Waiter extends Node:
	signal clicked

	func _input(event: InputEvent) -> void:
		if event is InputEventMouseButton and event.pressed:
			get_viewport().set_input_as_handled()
			clicked.emit()


var _waiter: _Waiter


func configure() -> ESCCommandArgumentDescriptor:
	return ESCCommandArgumentDescriptor.new(0, [], [])


func run(_command_params: Array) -> int:
	_waiter = _Waiter.new()
	escoria.add_child(_waiter)
	await _waiter.clicked
	_waiter.queue_free()
	_waiter = null
	return ESCExecution.RC_OK


func interrupt():
	if is_instance_valid(_waiter):
		_waiter.clicked.emit()
