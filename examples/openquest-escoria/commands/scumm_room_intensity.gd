class_name ScummRoomIntensityCommand
extends ESCBaseCommand
# Generated by scumm2escoria.
# `scumm_room_intensity(red, green, blue)`: SCUMM's setRoomRGBIntensity over the
# whole palette, each channel scaled by n/255 (255, 255, 255: setRoomPalette(0),
# the room's own colors). Everything on screen dims, verb bar included, like
# SCUMM's single palette. The layer belongs to the room: entering another room
# reloads its palette, as in SCUMM (entry scripts dim it again if needed).

const LAYER_NAME := "ScummPalette"
const SHADER := """
shader_type canvas_item;
render_mode blend_mul;
uniform vec3 scale = vec3(1.0);
void fragment() {
	COLOR = vec4(scale, 1.0);
}
"""


func configure() -> ESCCommandArgumentDescriptor:
	return ESCCommandArgumentDescriptor.new(3, [TYPE_INT, TYPE_INT, TYPE_INT], [null, null, null])


func run(command_params: Array) -> int:
	var room: Node = escoria.main.current_scene
	var layer: CanvasLayer = room.get_node_or_null(LAYER_NAME)
	var scale := Vector3(command_params[0], command_params[1], command_params[2]) / 255.0
	if scale.x >= 1.0 and scale.y >= 1.0 and scale.z >= 1.0:
		if layer:
			layer.queue_free()
		return ESCExecution.RC_OK
	if layer == null:
		layer = CanvasLayer.new()
		layer.name = LAYER_NAME
		layer.layer = 99     # over the room and the UI, under the room transitions
		var rect := ColorRect.new()
		rect.set_anchors_preset(Control.PRESET_FULL_RECT)
		rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
		var shader := Shader.new()
		shader.code = SHADER
		rect.material = ShaderMaterial.new()
		rect.material.shader = shader
		layer.add_child(rect)
		room.add_child(layer)
	layer.get_child(0).material.set_shader_parameter("scale", scale)
	return ESCExecution.RC_OK


func interrupt():
	pass
