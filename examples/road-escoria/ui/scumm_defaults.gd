class_name ScummDefaults
# Generated by scumm2escoria. SCUMM's default action script gets objA / objB;
# Escoria's action_defaults.esc doesn't, so before an action runs (patched
# esc_action_manager.gd) its objects are published as globals:
#   scumm_object_a / scumm_object_b: global ids ("" = none)
#   scumm_a_<class> / scumm_b_<class>: their SCUMM classes (custom_data)
#   scumm_inventory_a: the inventory item objA stands for (InventoryObject)

const CLASSES := {"Class1": "class1", "Class2": "class2"}


static func publish(a: ESCObject, b: ESCObject) -> void:
	_publish_one("a", a)
	_publish_one("b", b)
	var inventory := ""
	if a and is_instance_valid(a.node) and a.node.custom_data.has("scumm_inventory_object"):
		inventory = a.node.custom_data["scumm_inventory_object"]
	escoria.globals_manager.set_global("scumm_inventory_a", inventory, true)


static func _publish_one(which: String, obj: ESCObject) -> void:
	var classes: Array = []
	if obj and is_instance_valid(obj.node) and "custom_data" in obj.node:
		classes = obj.node.custom_data.get("scumm_classes", [])
	escoria.globals_manager.set_global("scumm_object_" + which, obj.global_id if obj else "", true)
	var state = escoria.globals_manager.get_global(obj.global_id + "_state") if obj else 0
	escoria.globals_manager.set_global("scumm_%s_state" % which, state if state else 0, true)
	var actor: bool = obj != null and is_instance_valid(obj.node) and "custom_data" in obj.node \
			and obj.node.custom_data.get("scumm_actor", false)
	escoria.globals_manager.set_global("scumm_%s_actor" % which, actor, true)
	for cls in CLASSES:
		escoria.globals_manager.set_global("scumm_%s_%s" % [which, CLASSES[cls]], cls in classes, true)
