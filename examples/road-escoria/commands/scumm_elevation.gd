class_name ScummElevationCommand
extends ESCBaseCommand
# Generated by scumm2escoria.
# `scumm_elevation(object, pixels)`: SCUMM's setActorElevation, the actor is
# drawn `pixels` (SCUMM pixels) above its position; depth still uses the feet.

const SCALE := 4


func configure() -> ESCCommandArgumentDescriptor:
	return ESCCommandArgumentDescriptor.new(2, [TYPE_STRING, TYPE_INT], [null, null])


func validate(arguments: Array):
	if not super.validate(arguments):
		return false
	if not escoria.object_manager.has(arguments[0]):
		raise_invalid_object_error(self, arguments[0])
		return false
	return true


func run(command_params: Array) -> int:
	var node: ESCItem = escoria.object_manager.get_object(command_params[0]).node
	var sprite = node.get_node_or_null("sprite")
	if sprite and node.custom_data.has("scumm_base_offset_y"):
		sprite.offset.y = node.custom_data["scumm_base_offset_y"] - command_params[1] * SCALE
	return ESCExecution.RC_OK


func interrupt():
	pass
