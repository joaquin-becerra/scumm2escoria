class_name ScummSetNameCommand
extends ESCBaseCommand
# Generated by scumm2escoria.
# `scumm_set_name(object, name)`: SCUMM's setObjectName, the name the sentence
# line shows. Kept in a global (scumm_name_<object>) so it survives room
# changes and saved games; scumm_restore_names() applies it again.

const PREFIX := "scumm_name_"


func configure() -> ESCCommandArgumentDescriptor:
	return ESCCommandArgumentDescriptor.new(2, [TYPE_STRING, TYPE_STRING], [null, null])


func run(command_params: Array) -> int:
	escoria.globals_manager.set_global(PREFIX + command_params[0], command_params[1], true)
	apply(command_params[0], command_params[1])
	return ESCExecution.RC_OK


static func apply(global_id: String, name: String) -> void:
	if escoria.object_manager.has(global_id):
		var obj = escoria.object_manager.get_object(global_id)
		if obj and is_instance_valid(obj.node) and "tooltip_name" in obj.node:
			obj.node.tooltip_name = name


func interrupt():
	pass
